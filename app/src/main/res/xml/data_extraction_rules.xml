<?xml version="1.0" encoding="utf-8"?>
<!-- Weeks, reviews, and Someday live in the database, so it travels with device backups and transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
